# Newsletter — pick one. Set these in Vercel → Project → Settings → Environment Variables.

# Option A: Resend audience (resend.com → Audiences → copy the ID)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Option B: any JSON webhook (Make, Zapier, Loops, n8n…) that accepts { email, source }
NEWSLETTER_WEBHOOK_URL=
